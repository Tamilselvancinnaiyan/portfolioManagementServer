generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
}

enum AssetType {
  INDIAN_EQUITY
  US_EQUITY
  ETF
}

enum AlertCondition {
  ABOVE
  BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISABLED
}

enum ImportStatus {
  PREVIEW
  QUEUED
  COMPLETED
  FAILED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(254)
  passwordHash  String
  baseCurrency  String         @default("INR") @db.VarChar(3)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  portfolios    Portfolio[]
  refreshTokens RefreshToken[]
  watchlists    Watchlist[]
  alerts        PriceAlert[]
  notifications Notification[]
  imports       ImportJob[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Portfolio {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(100)
  description  String?       @db.VarChar(1000)
  baseCurrency String        @db.VarChar(3)
  revision     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
  imports      ImportJob[]

  @@index([userId, deletedAt])
}

model Stock {
  id             String          @id @default(uuid()) @db.Uuid
  symbol         String          @unique @db.VarChar(20)
  name           String          @db.VarChar(150)
  exchange       String          @db.VarChar(20)
  currency       String          @db.VarChar(3)
  assetType      AssetType
  sector         String
  industry       String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  watchlistItems WatchlistItem[]
  alerts         PriceAlert[]

  @@index([name])
}

model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  sequence          BigInt          @unique @default(autoincrement())
  portfolioId       String          @db.Uuid
  stockId           String?         @db.Uuid
  type              TransactionType
  quantity          Decimal         @default(0) @db.Decimal(24, 8)
  price             Decimal         @default(0) @db.Decimal(24, 8)
  fees              Decimal         @default(0) @db.Decimal(24, 8)
  amount            Decimal         @default(0) @db.Decimal(24, 8)
  transactionDate   DateTime        @db.Date
  notes             String?         @db.VarChar(1000)
  importFingerprint String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  portfolio         Portfolio       @relation(fields: [portfolioId], references: [id])
  stock             Stock?          @relation(fields: [stockId], references: [id])

  @@index([portfolioId, transactionDate, sequence])
  @@index([portfolioId, stockId])
  @@index([portfolioId, type])
  @@index([portfolioId, importFingerprint])
}

model Watchlist {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  name      String          @db.VarChar(100)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  user      User            @relation(fields: [userId], references: [id])
  items     WatchlistItem[]

  @@index([userId, deletedAt])
}

model WatchlistItem {
  id          String    @id @default(uuid()) @db.Uuid
  watchlistId String    @db.Uuid
  stockId     String    @db.Uuid
  createdAt   DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  stock       Stock     @relation(fields: [stockId], references: [id])

  @@unique([watchlistId, stockId])
}

model PriceAlert {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  stockId       String         @db.Uuid
  condition     AlertCondition
  targetPrice   Decimal        @db.Decimal(24, 8)
  status        AlertStatus    @default(ACTIVE)
  triggeredAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  stock         Stock          @relation(fields: [stockId], references: [id])
  notifications Notification[]

  @@index([userId, status])
  @@index([stockId, status])
}

model Notification {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  alertId   String?     @unique @db.Uuid
  message   String
  readAt    DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id])
  alert     PriceAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  portfolioId String       @db.Uuid
  status      ImportStatus @default(PREVIEW)
  rows        Json
  report      Json
  error       String?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id])
  portfolio   Portfolio    @relation(fields: [portfolioId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  entityId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
